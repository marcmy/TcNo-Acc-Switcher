{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "dev": "vite",
    "build:dev": "vite build --minify false --mode development",
    "build": "vite build --mode production",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "minify:svg": "svgo --config svgo.config.mjs -r -f public/img"
  },
  "dependencies": {
    "@wailsio/runtime": "3.0.0-beta.28",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "26.6.5",
    "sass": "1.105.2",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "svgo": "4.1.0",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
